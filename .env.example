# Monocle environment variables (reference for apps that install monocle2ai).
# Copy the ones you need into your app's .env. [NEW] marks keys added by the
# recent preload / Next.js / hook-audit work.

# ─── Core ────────────────────────────────────────────────────────────────────
# Service / workflow name — the trace's root span name. Read by `monocle2ai/register`.
MONOCLE_WORKFLOW_NAME=my-app
# Where spans go: console | file | s3 | azure | okahu (comma-separated for several).
MONOCLE_EXPORTER=file
# Batch export interval in ms (default 5000).
MONOCLE_EXPORTER_DELAY=5000

# ─── Preload (how Monocle starts before your app graph loads) ────────────────
# [NEW] Preloads Monocle before the app's imports so import-in-the-middle can hook
# them. Node reads NODE_OPTIONS at process STARTUP, so it works via `--env-file`
# (scripts) and is forwarded to the spawned server by `mastra dev`. Required for
# tsx/node scripts and mastra dev; NOT needed for Next.js (use instrumentation.ts
# register() + withMonocle instead). NODE_OPTIONS is a Node built-in — it cannot be
# renamed, because Node only reads this specific variable at startup.
NODE_OPTIONS=--import monocle2ai/register
# [NEW] ms to hold the event loop open on exit so batched spans flush before a
# short-lived script exits (default 6000). Ignored by long-running servers.
MONOCLE_FLUSH_MS=6000

# ─── Hook audit (bundler misconfig warning) ──────────────────────────────────
# [NEW] Under a bundler (Next.js), Monocle warns when an instrumented dependency
# was installed but never hooked — the sign it got bundled/inlined and can't be
# traced. These tune that warning.
# Silence the warning entirely.
MONOCLE_DISABLE_HOOK_AUDIT=true
# Run the audit even outside a bundler runtime (debugging only).
MONOCLE_FORCE_HOOK_AUDIT=true
# Delay before the audit runs, in ms (default 20000).
MONOCLE_HOOK_AUDIT_DELAY_MS=20000

# ─── Debug ───────────────────────────────────────────────────────────────────
# Verbose Monocle logs.
MONOCLE_DEBUG=true

# ─── File exporter (MONOCLE_EXPORTER=file) ───────────────────────────────────
# Output directory (default ./.monocle). Use an absolute path under `mastra dev`,
# whose working directory differs from your project root.
MONOCLE_TRACE_OUTPUT_PATH=/abs/path/.monocle
# Trace filename prefix (default monocle_trace_).
MONOCLE_FILE_PREFIX=monocle_trace_

# ─── S3 exporter (MONOCLE_EXPORTER=s3) ───────────────────────────────────────
MONOCLE_S3_BUCKET_NAME=
MONOCLE_S3_KEY_PREFIX=monocle_trace_
MONOCLE_AWS_ACCESS_KEY_ID=
MONOCLE_AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1

# ─── Azure Blob exporter (MONOCLE_EXPORTER=azure) ────────────────────────────
MONOCLE_BLOB_CONNECTION_STRING=
MONOCLE_BLOB_CONTAINER_NAME=
MONOCLE_AZURE_BLOB_PREFIX=monocle_trace_

# ─── Okahu exporter (MONOCLE_EXPORTER=okahu) ─────────────────────────────────
OKAHU_API_KEY=
OKAHU_INGESTION_ENDPOINT=
